{
  "manifest_version": 3,
  "name": "Testleaf LocatorX",
  "version": "1.0.0",
  "description": "Inspect elements and generate scored Playwright locators with POM export.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Testleaf LocatorX",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}